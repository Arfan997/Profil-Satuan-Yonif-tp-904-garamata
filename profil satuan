<style>
:root {
    --black: #080606;
    --black2: #110909;

    --red: #741b18;
    --red2: #941f1a;
    --red3: #b52b22;
    --red-dark: #3c0d0b;

    --gold: #c9a84e;
    --gold2: #f0d477;
    --gold3: #ffe9a0;

    --white: #f7f4ed;
    --muted: #b9afa7;

    --line: rgba(201,168,78,.25);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--black);
    color: var(--white);
    overflow-x: hidden;
}

/* NAVBAR */

nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;

    height: 75px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 6%;

    background: rgba(8,5,5,.88);
    backdrop-filter: blur(18px);

    border-bottom: 1px solid var(--line);
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;

    font-weight: 900;
    letter-spacing: 1px;
}

.brand-mark {
    width: 48px;
    height: 48px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid var(--gold);
    border-radius: 50%;

    background: rgba(116,27,24,.35);
    overflow: hidden;
}

.brand-mark img {
    width: 88%;
    height: 88%;
    object-fit: contain;
}

.brand span {
    font-size: 14px;
    color: var(--white);
}

nav ul {
    display: flex;
    gap: 28px;
    list-style: none;
}

nav a {
    color: #ded6d0;
    text-decoration: none;

    font-size: 12px;
    font-weight: 700;

    transition: .3s;
}

nav a:hover {
    color: var(--gold2);
}

